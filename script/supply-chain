#!/bin/sh
#
# script/supply-chain: the milestone-42 gate. Two questions nothing else in the suite asks.
#
#   1. Does anything in the dependency graph carry a published advisory, an unmaintained notice, a
#      yank, a licence we have not accepted, a duplicate version, or a source that is not crates.io?
#      That is cargo-deny, configured in deny.toml with a reason next to every knob.
#   2. Is the vendored tree actually the upstream release we say it is? That is script/vendor-verify.
#
# **Why this is a gate and not a report.** The thesis is that this kernel confines code it did not
# write (DECISIONS §14, §27, §31, notes/redoxfs-audit.md). Not knowing when that code has a published
# advisory was an odd blind spot for a project making that claim, and it stays a blind spot unless
# something red-lights.
#
# Not part of script/lint on purpose: lint is the offline inner-loop gate, and both halves here need
# the network (an advisory-database clone, a crates.io tarball on a cold cache). It gets its own CI
# job for the same reason.
#
# **One run per committed lockfile, discovered rather than listed**, because cargo-deny works one
# graph at a time and the tree keeps growing workspaces of its own. It runs once per manifest
# against the one shared deny.toml. One policy everywhere is the point: a licence we would refuse in
# the kernel is not acceptable in the host tooling either. `script/audits` counts the same lockfiles
# for its external-packages trigger, so the two read one set. Two are skipped for a stated reason,
# and a lockfile beside no Cargo.toml that is not one of them fails the run:
#
#   - **vendor/** is somebody else's graph. vendor/redoxfs enters our builds only through
#     redoxfs_server and tools/redoxfs_host, at the feature sets we actually build; checking it
#     standalone would evaluate its default features (`fuse`, which wants macFUSE) and report on
#     code nothing here ever compiles.
#   - **notes/packages/container-format-measurements/fuzz/** is a measuring harness for that note,
#     kept as `Cargo.toml.in` so no cargo command treats it as a crate. Nothing builds or ships it.
#
# See notes/scripts.md.
#
# Name: recorded (CLAUDE.md's naming tenet, which cites this name by name). "We do not rename
# `elf`, and we should not respell `supply-chain` either: a name whose shape a reader already knows
# from outside costs them nothing." That covers both halves at once, since "supply chain" is the
# field's phrase for the thing and this script did not coin it; the hyphen is then the directory's
# rule rather than a choice. It is an argument for keeping the name, made about this name, which is
# what `recorded` claims. calef has not ruled on it. Introduced 2026-07-30 to run cargo-deny over
# every workspace.

set -e
cd "$(dirname "$0")/.."

# The version is PINNED in .cargo-deny-version, the same discipline as .qemu-version and
# rust-toolchain.toml, and this one is a scar rather than caution. The first CI run of this script
# failed instantly: the developer machine had 0.19.1, where `--config` belongs to the `check`
# subcommand, and CI installed 0.20.2, where it belongs to the top level and defaults to
# `<cwd>/deny.toml` instead of the workspace root. Same config, same tree, two different CLIs and one
# of them silently reading a different file. A tool whose verdict is a gate has to be the same tool
# everywhere.
#
# Auto-install on absence or mismatch, the same trade script/coverage makes: script/bootstrap runs in
# the CI test job, which must not spend minutes compiling a tool it never uses. CI installs a
# prebuilt binary of the pinned version in the one job that needs it.
pinned="$(cat .cargo-deny-version)"
installed="$(cargo deny --version 2>/dev/null | awk '{print $2}')"
if [ "$installed" != "$pinned" ]; then
    echo "==> Installing cargo-deny $pinned (have: ${installed:-none})"
    cargo install --locked "cargo-deny@$pinned"
fi

# -A unmatched-skip: deny.toml's `[bans] skip` list is written for the workspace that needs each
# entry, and the same file is applied to every graph. A skip that is irrelevant to the workspace being
# checked is expected, not a finding. (The mirror-image warning for the licence ALLOW-list is handled
# in the config itself, via `unused-allowed-license`.)
#
# -A license-exception-not-encountered: the third member of that family, and it arrived with the
# fuzz workspace. `[[licenses.exceptions]]` scopes NCSA to `libfuzzer-sys`, which exists in exactly
# one graph, so every other run correctly reports that the exception went unused. Scoping
# the exception to one crate is the strict choice; this is what it costs.
#
manifests=""
for lock in $(git ls-files '*Cargo.lock'); do
    dir="$(dirname "$lock")"
    case "$dir/" in
        vendor/* | notes/packages/container-format-measurements/fuzz/) continue ;;
    esac
    if [ ! -f "$dir/Cargo.toml" ]; then
        echo "supply-chain: $lock has no Cargo.toml beside it, so cargo-deny cannot read its graph;" >&2
        echo "  give it one, or skip it above with the reason nothing ships it" >&2
        exit 1
    fi
    manifests="$manifests $dir/Cargo.toml"
done

for manifest in $manifests; do
    echo "==> cargo-deny: $manifest"
    cargo deny --manifest-path "$manifest" --all-features --config deny.toml \
        check -A unmatched-skip -A license-exception-not-encountered
done

echo "==> vendored integrity"
"$(dirname "$0")/vendor-verify"
