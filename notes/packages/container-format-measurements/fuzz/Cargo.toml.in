# Name: provisional, lane/package-format-measurements, 2026-10-17 (UTC). A measuring harness for
# notes/packages/container-format-measurements.md, named for its job there; never published or
# depended on by the tree.
[package]
name = "fuzzing"
version = "0.0.0"
edition = "2024"
publish = false
[package.metadata]
cargo-fuzz = true
[dependencies]
libfuzzer-sys = "0.4"
tar-no-std = "=0.5.0"
ruzstd = { version = "=0.9.1", default-features = false, features = ["std"] }
[[bin]]
name = "tar_no_std"
path = "fuzz_targets/tar_no_std.rs"
test = false
doc = false
bench = false
[[bin]]
name = "ruzstd"
path = "fuzz_targets/ruzstd.rs"
test = false
doc = false
bench = false
[workspace]
