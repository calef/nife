# Name: provisional, lane/package-format-measurements, 2026-10-17 (UTC). A measuring harness for
# notes/packages/container-format-measurements.md, named for its job there; never published or
# depended on by the tree.
[package]
name = "size"
version = "0.0.0"
edition = "2024"
publish = false

[features]
none = []
manifest_only = []
n1 = ["dep:package_archive"]
n2 = []
tar_own = []
tar_own_ustar = ["readers/tar_own_ustar"]
tar_no_std = ["dep:tar-no-std"]
ruzstd = ["dep:ruzstd", "dep:static_alloc"]
ruzstd_on = ["ruzstd"]

[dependencies]
readers = { path = "../readers" }
package_archive = { path = "@NIFE@/crates/package_archive", optional = true }
tar-no-std = { version = "=0.5.0", optional = true }
ruzstd = { version = "=0.9.1", default-features = false, optional = true }
static_alloc = { package = "static-alloc", version = "=0.3.3", optional = true }

[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1
overflow-checks = true
panic = "abort"

[workspace]
