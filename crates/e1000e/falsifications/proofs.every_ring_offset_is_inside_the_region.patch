+++ b/crates/e1000e/src/layout.rs
@@ -22,7 +22,7 @@ pub const fn tx_buffer(i: u16) -> u64 {
 }
 /// Receive descriptor `i`'s offset.
 pub const fn rx_descriptor(i: u16) -> u64 {
-    RX_RING + (i % RX_ENTRIES) as u64 * 16
+    RX_RING + i as u64 * 16
 }
