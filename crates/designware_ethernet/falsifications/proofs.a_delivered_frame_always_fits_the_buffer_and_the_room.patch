Falsifies `designware_ethernet::proofs::a_delivered_frame_always_fits_the_buffer_and_the_room`.

The defect: the receive verdict forgets the caller's room. Every length the device can state up to
a full frame is then accepted, so a caller offering a 576-byte buffer is told to copy 1514.

Expected to fail: the harness's `assert!(n <= room)`, on any word with a valid length above room.

diff --git a/crates/designware_ethernet/src/descriptor.rs b/crates/designware_ethernet/src/descriptor.rs
index f61e9c9c2..07f94e734 100644
--- a/crates/designware_ethernet/src/descriptor.rs
+++ b/crates/designware_ethernet/src/descriptor.rs
@@ -125,7 +125,7 @@ pub fn rx_verdict(des3: u32, room: usize) -> RxVerdict {
     let Some(len) = wire.checked_sub(CRC_BYTES) else {
         return RxVerdict::Drop;
     };
-    let fits = (14..=MAX_FRAME).contains(&len) && len <= room && wire as u64 <= BUFFER_SIZE;
+    let fits = (14..=MAX_FRAME).contains(&len) && wire as u64 <= BUFFER_SIZE;
     if !fits {
         return RxVerdict::Drop;
     }
